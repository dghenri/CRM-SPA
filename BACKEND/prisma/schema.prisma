generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  Active
  Inactive
  OnLeave
}

// Cargo = NÍVEL DE ACESSO/PERMISSÃO no sistema (hierarquia: Admin > Manager > Employee).
// A função/profissão da pessoa (Farmacêutica, Massoterapeuta...) fica em `Profession`.
enum StaffRole {
  Admin    // acesso total
  Manager  // gerencia a operação (acesso intermediário)
  Employee // acesso operacional
}

enum Gender {
  Male
  Female
  Other
  PreferNotToSay
}

enum CouponDiscountType {
  Percentage // desconto em % sobre o valor da compra
  Fixed      // desconto em valor fixo (R$)
}

// Equivalente ao campo `applicable_to` do rascunho: define pra que o cupom vale.
enum CouponScope {
  AllServices      // vale pra qualquer serviço
  SpecificServices // vale só pros serviços em Coupon.serviceIds
  Category         // vale só pra uma categoria (Coupon.category)
  FirstPurchase    // vale só na primeira compra do cliente
  SpecificCustomer // vale só pro cliente em Coupon.userId
}

enum AppointmentStatus {
  Scheduled
  Confirmed
  Completed
  Cancelled
  NoShow
}

// forma de pagamento escolhida no agendamento (usada na página de receita/faturamento)
enum PaymentMethod {
  Pix
  CreditCard
  DebitCard
  Cash
}

model Staff {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  email     String      @unique
  name      String
  password  String
  phone     String?
  role      StaffRole // nível de acesso (permissões)
  birthdate DateTime
  status    StaffStatus  @default(Active)

  // função/profissão exercida na clínica (Desenvolvedor, Suporte, Farmacêutica...).
  // Opcional: contas migradas começam sem profissão até alguém definir.
  professionId String?     @db.ObjectId
  profession   Profession? @relation(fields: [professionId], references: [id])

  // Permissões: o cargo (role) define o padrão (ver src/lib/permissions.js).
  // customPermissions = true -> vale a lista `permissions` no lugar do padrão do cargo
  // (o Admin sempre tem tudo, independente disto). null/false = usa o padrão do cargo.
  customPermissions Boolean?
  permissions       String[]

  // caminho da foto de perfil (ex: /uploads/avatars/staff-<id>-<ts>.jpg); null = sem foto
  avatarUrl String?

  // sessões (JWT) emitidas antes deste instante deixam de valer: usado por "sair de outros dispositivos"
  sessionsValidFrom DateTime?

  // preferências pessoais da funcionária (ex: { dragAppointments: false,
  // theme: "system" }) - campo único e genérico pra não precisar de uma
  // migration de schema toda vez que surgir uma configuração nova.
  // Opcional: quando ausente, o back-end aplica DEFAULT_STAFF_SETTINGS.
  settings Json?

  appointments Appointment[]
  services     Service[]

  // dias/horários em que a funcionária atende (vários intervalos por dia)
  availability StaffAvailability[]

  // estoque
  executedMovements StockMovement[] @relation("MovementExecutor")
  stockRequests     StockRequest[]  @relation("RequestedBy")
  reviewedRequests  StockRequest[]  @relation("ReviewedBy")
}

// Função/profissão dos profissionais da clínica. É uma coleção (e não um enum)
// para a equipe poder cadastrar novas funções sem alterar o schema.
model Profession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // ex: "Farmacêutica(o)", "Massoterapeuta"
  slug      String   @unique // ex: "farmaceutica", "massoterapeuta" (estável, usado em scripts/regras)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]
}

// Disponibilidade semanal da funcionária. Um registro = um intervalo de
// trabalho num dia da semana. Vários registros no mesmo dia permitem pausas
// (ex: 08:00-12:00 e 14:00-18:00). Dia sem registro = não trabalha.
model StaffAvailability {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  weekday   Int // 0 = domingo ... 6 = sábado (mesmo padrão do Date.getDay())
  startTime String // "HH:mm" (24h)
  endTime   String // "HH:mm" (24h), sempre maior que startTime

  staffId String @db.ObjectId
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  cpf       String    @unique
  name      String
  password  String
  gender    Gender?
  phone     String?
  // Progressive Profiling: cadastro inicial só exige nome, CPF, email e senha
  // - esses campos ficam pra serem completados depois, com a conta já criada.
  birthdate DateTime?
  // Atualizado a cada login bem-sucedido (/auth/user/login). Usado pra
  // identificar contas inativas (ex: lastLogin nulo ou muito antigo).
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // relações 1-para-muitos
  // cupons criados como exclusivos deste cliente (coupon.userId aponta pra cá)
  exclusiveCoupons  Coupon[]
  couponRedemptions CouponRedemption[]
  appointments      Appointment[]

  // relação muitos-para-muitos (favoritos) — padrão MongoDB do Prisma:
  // cada lado guarda seu próprio array de ObjectIds
  favoriteServiceIds String[] @db.ObjectId
  favoriteServices   Service[] @relation(fields: [favoriteServiceIds], references: [id])

  // Foto de perfil: por enquanto uma miniatura JPEG (256px, ~20-40 KB) guardada
  // como data URL. Quando existir uma API de upload de imagens, troque por a
  // URL do arquivo - o front só lê este campo.
  avatarUrl String?

  // Preferências de notificação (ver DEFAULT_USER_NOTIFICATIONS em lib/serializers.js).
  // Json: novas preferências entram sem migration.
  notificationPrefs Json?

  // Avisos do sistema (ex: "agende sua primeira sessão") que o cliente dispensou
  // no sino. Guarda só a chave do aviso; avisos que dependem de ação
  // obrigatória (completar o perfil) não podem ser dispensados.
  dismissedAlertKeys String[]

  addresses Address[]

  // sessões (JWT) emitidas antes deste instante deixam de valer: usado por "sair de outros dispositivos"
  sessionsValidFrom DateTime?
}

// Endereços do cliente (vários por cliente, um deles é o principal)
model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String? // "Casa", "Trabalho"...
  zipCode      String // CEP, só dígitos (8)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String // UF, 2 letras maiúsculas
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  code          String             @unique // código que o cliente digita, ex: BEMVINDO10
  description   String? // descrição interna, só pra equipe (não aparece pro cliente)
  discountType  CouponDiscountType
  discountValue Float // percentual (ex: 10) ou valor fixo em R$ (ex: 20), conforme discountType

  minPurchase Float? // valor mínimo da compra pra poder usar o cupom
  maxDiscount Float? // teto do desconto (útil sobretudo em cupons percentuais)

  startsAt  DateTime? // se vazio, já vale imediatamente
  expiresAt DateTime? // se vazio, não expira

  usageLimit   Int? // limite total de usos (todos os clientes somados); vazio = ilimitado
  usageCount   Int  @default(0) // contador de quantas vezes já foi usado
  perUserLimit Int? @default(1) // limite de uso por cliente; vazio = ilimitado

  archivedAt DateTime? // presente = cupom arquivado (some das listas ativas)

  // applicable_to: pra que o cupom vale. O campo usado depende de `scope`:
  // - AllServices / FirstPurchase: nenhum campo extra é necessário
  // - SpecificServices: usa `serviceIds`
  // - Category: usa `category` (texto livre, o Service ainda não tem campo de categoria)
  // - SpecificCustomer: usa `userId` (abaixo)
  scope      CouponScope @default(AllServices)
  serviceIds String[]    @db.ObjectId // ids de Service; sem relação formal (evita escrita multi-documento/transação no Mongo)
  category   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // opcional: cupom exclusivo pra um cliente específico. Se vazio, vale pra qualquer cliente.
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  redemptions CouponRedemption[]
}

// Registro de cada uso de um cupom (equivalente à tabela "coupon_usages" do rascunho)
model CouponRedemption {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  couponId String @db.ObjectId
  coupon   Coupon @relation(fields: [couponId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // "resgatar" só adiciona o cupom à carteira do cliente (claim). Ele só passa
  // a valer como uso de verdade (usedAt preenchido) quando é aplicado de fato
  // num agendamento - é isso que decide se aparece em Disponíveis ou Usados.
  claimedAt      DateTime  @default(now())
  usedAt         DateTime?
  discountAmount Float? // só é definido quando o cupom é aplicado (usedAt preenchido)
}

model Appointment {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  code      String            @unique // código de 6 letras mostrado ao cliente (não é o _id do Mongo)
  title     String
  date      DateTime // início
  endDate   DateTime // término
  color     String            @default("blue")
  status    AppointmentStatus @default(Scheduled)
  notes     String?
  // por onde o dinheiro entra (nulo = agendamentos antigos / eventos avulsos)
  paymentMethod PaymentMethod?
  // quando o profissional clicou em "Iniciar atendimento" (nulo = ainda não iniciado)
  startedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // opcionais: a agenda permite criar um evento avulso sem vincular a um
  // cliente/serviço cadastrado (ex: "Almoço com equipe")
  customerId String? @db.ObjectId
  customer   User?   @relation(fields: [customerId], references: [id])

  serviceId String?  @db.ObjectId
  service   Service? @relation(fields: [serviceId], references: [id])

  // profissional responsável pela sessão - opcional pra não quebrar
  // agendamentos avulsos sem ninguém definido ainda
  professionalId String? @db.ObjectId
  professional   Staff?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  // nome da profissional guardado quando a conta dela é excluída (fica no histórico das sessões
  // passadas, já que professionalId vira nulo). Enquanto ela existir, o nome vem de `professional`.
  professionalName String?

  couponRedemptions CouponRedemption[]

  // consumo de estoque gerado por este atendimento (fase 2: receitas)
  stockMovements StockMovement[]
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  duration    Int
  price       Float
  image       String
  available   Boolean  @default(true)
  category    String? // usado pelo escopo "Category" dos cupons (Coupon.scope = Category)
  // idade mínima (anos) do cliente para agendar este procedimento; null = sem restrição.
  // Opcional de propósito: procedimentos já cadastrados no Mongo não têm o campo.
  minAge      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  // insumos consumidos a cada execução deste procedimento (receita)
  recipeItems RecipeItem[]

  favoritedByIds String[] @db.ObjectId
  favoritedBy    User[]   @relation(fields: [favoritedByIds], references: [id])

  // profissional responsável pelo procedimento - opcional pra não quebrar
  // procedimentos já cadastrados sem ninguém definido ainda
  professionalId String? @db.ObjectId
  professional   Staff?  @relation(fields: [professionalId], references: [id])
}


//=============================================================== ESTOQUE (INSUMOS)

enum StockUnit {
  Un // unidades (ex: unidades de toxina)
  Ml
  G
}

enum StockMovementType {
  Purchase    // entrada por compra
  Consumption // saída automática por procedimento (fase 2: receitas)
  Adjustment  // correção de inventário (+ ou -)
  Loss        // perda, quebra, vencimento
  Return      // estorno de consumo
}

enum StockRequestStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

// Item de uma solicitação (embutido no documento, sem coleção própria).
// `quantity` é SEMPRE em unidade base do produto. Em Purchase, o back-end
// calcula quantity = packages * Product.purchaseUnitSize.
type StockRequestItem {
  productId String    @db.ObjectId
  quantity  Float     // base; Purchase/Loss > 0, Adjustment com sinal (+/-)
  packages  Float?    // só Purchase: nº de embalagens (frascos, ampolas, caixas)
  batchId   String?   @db.ObjectId // Loss/Adjustment: lote afetado (Loss sem lote = FEFO)
  lotNumber String?   // só Purchase
  expiresAt DateTime? // só Purchase
  unitCost  Float?    // só Purchase: custo por unidade base
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  sku       String?  @unique
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // unidade base = a menor que é consumida (receitas e saldo usam sempre ela)
  unit              StockUnit
  purchaseUnitLabel String? // "frasco", "ampola", "caixa"
  purchaseUnitSize  Float   @default(1) // quantas unidades base cabem em 1 embalagem

  minStock     Float  @default(0) // alerta de reposição
  currentStock Float  @default(0) // cache: soma dos lotes
  lastCost     Float? // custo por unidade base

  // controle de frasco aberto: quando ligado, cada embalagem comprada vira um
  // lote próprio (pra registrar a abertura de cada frasco individualmente)
  trackOpening            Boolean @default(false)
  shelfLifeAfterOpenHours Int? // validade depois de aberto (ex: 24)

  // profissões que podem SOLICITAR movimentações deste produto. Vazio = só
  // Admin/Manager. Admin e Manager sempre podem, independente desta lista.
  // (sem relação formal: ids de Profession, mesmo padrão de Coupon.serviceIds)
  allowedProfessionIds String[] @db.ObjectId

  batches     StockBatch[]
  movements   StockMovement[]
  recipeItems RecipeItem[]
}

model StockBatch {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  lotNumber  String?
  expiresAt  DateTime?
  quantity   Float // saldo restante, em unidade base
  unitCost   Float?
  receivedAt DateTime  @default(now())
  openedAt   DateTime? // quando o frasco foi aberto (só com Product.trackOpening)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  movements StockMovement[]
}

// Ledger: nunca é editado nem apagado. Saldo do produto = soma das quantities.
model StockMovement {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  type      StockMovementType
  quantity  Float // COM SINAL: + entra, - sai
  unitCost  Float?
  reason    String?
  createdAt DateTime          @default(now())

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  batchId String?     @db.ObjectId
  batch   StockBatch? @relation(fields: [batchId], references: [id])

  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  requestId String?       @db.ObjectId
  request   StockRequest? @relation(fields: [requestId], references: [id])

  // quem executou (quem aprovou, ou o próprio Admin/Manager quando aplica direto)
  staffId String @db.ObjectId
  staff   Staff  @relation("MovementExecutor", fields: [staffId], references: [id])
}

model StockRequest {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  type      StockMovementType // Purchase, Loss ou Adjustment
  status    StockRequestStatus @default(Pending)
  items     StockRequestItem[]
  reason    String?
  createdAt DateTime           @default(now())

  requestedById String @db.ObjectId
  requestedBy   Staff  @relation("RequestedBy", fields: [requestedById], references: [id])

  reviewedById String?   @db.ObjectId
  reviewedBy   Staff?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String? // motivo da negação

  movements StockMovement[]
}

// Receita: quanto de cada insumo um procedimento consome por execução.
// `quantity` é na unidade base do produto (ex: 30 un de toxina, 2 ml de ácido).
// O consumo real vira StockMovement (Consumption) quando o atendimento é concluído.
model RecipeItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Float

  serviceId String  @db.ObjectId
  service   Service @relation(fields: [serviceId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  @@unique([serviceId, productId])
}


//=============================================================== NOTIFICAÇÕES E BANNERS
// Cor/ênfase do aviso (mesmos status do <Alert> do HeroUI)
enum NotificationStatus {
  Default
  Accent
  Success
  Warning
  Danger
}

// Categoria do disparo da equipe: decide se respeita a preferência do cliente
// (User.notificationPrefs). General = sempre entrega.
enum NotificationCategory {
  General
  Promotions
  News
}

// Notificação guardada de UM cliente (aparece no sino da Home).
// Sem relação formal com User de propósito: assim excluir um cliente não
// esbarra em integridade referencial (as notificações dele ficam órfãs e
// inofensivas). Dispensar = apagar a linha.
model Notification {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  userId      String               @db.ObjectId
  status      NotificationStatus   @default(Default)
  category    NotificationCategory @default(General)
  title       String
  description String?
  actionLabel String?
  actionPath  String? // rota interna do app, ex: /user/scheduling
  // de onde veio: "appointment-created", "appointment-confirmed"... ou "broadcast" (disparo da equipe)
  kind        String?
  broadcastId String?              @db.ObjectId
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([broadcastId])
}

// Registro de um disparo manual da equipe (a "mensagem original"); cada
// cliente atingido recebe uma Notification com o mesmo broadcastId.
model NotificationBroadcast {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  status         NotificationStatus   @default(Default)
  category       NotificationCategory @default(General)
  actionLabel    String?
  actionPath     String?
  audience       String // "all" | "selected"
  recipientCount Int                  @default(0)
  createdById    String?              @db.ObjectId
  createdByName  String?
  createdAt      DateTime             @default(now())
}

// Banner do carrossel da Home do cliente, criado pela equipe.
// (Os banners "inteligentes" - perfil incompleto, cupom de boas-vindas - são
// calculados pelo servidor e não ficam nesta tabela.)
model Banner {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  buttonLabel String?
  path        String? // rota interna do app
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  order       Int       @default(0) // menor aparece primeiro
  createdByName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Pedidos de recuperação de senha (cliente = "user", colaborador = "staff").
// Guarda só o HASH do token enviado por e-mail; o link vale por tempo limitado e é de uso único.
model PasswordReset {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String    @unique
  accountType String // "user" | "staff"
  accountId   String    @db.ObjectId
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountType, accountId])
}

//=============================================================== AUDITORIA
// Trilha de auditoria: quem mudou o quê e quando. Gravada automaticamente pela extensão do
// Prisma (src/lib/prisma.js). Sem relação formal com Staff/User de propósito: o log precisa
// sobreviver à exclusão de quem agiu (por isso guarda nome e cargo na hora). Apagado após RETENTION_DAYS.
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())

  action      String // create | update | delete | login | login_failed
  model       String? // Staff, Service, Coupon... (nulo em login)
  entityId    String?
  entityLabel String? // nome/título/código do registro, pra leitura humana
  summary     String

  before      Json? // campos que mudaram (valores antigos) ou o registro apagado
  after       Json? // campos que mudaram (valores novos) ou o registro criado

  actorType   String? // staff | user | system
  actorId     String?
  actorName   String?
  actorRole   String?

  ip          String?
  method      String?
  path        String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([model, entityId])
  @@index([action, createdAt])
}
